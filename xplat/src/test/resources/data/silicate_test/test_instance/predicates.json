{
	"type": "silicate_test:predicates",
	"environment": "silicate_test:default",
	"structure": "silicate_test:test_template",
	"max_ticks": 400,
	"conditions": [
		{
			"name": "EntityIsTypePredicates EntityType",
			"condition": {
				"predicate": "entity_is_type",
				"entity": "${this_entity}",
				"entity_type": "minecraft:skeleton_horse"
			}
		},
		{
			"name": "EntityIsTypePredicate TagKey",
			"condition": {
				"predicate": "entity_is_type",
				"entity": "${this_entity}",
				"entity_type": "#minecraft:skeletons"
			}
		},
		{
			"name": "Vec3Predicate",
			"condition": {
				"predicate": "vec3",
				"left": "${origin}",
				"comparison": [
					"=",
					">",
					"<="
				],
				"right": [
					1.5,
					1.0,
					1.5
				]
			}
		},
		{
			"name": "BlockEntityIsTypePredicate",
			"condition": {
				"predicate": "block_entity_is_type",
				"block_entity": "${block_entity}",
				"block_entity_type": "minecraft:furnace"
			}
		},
		{
			"name": "PlayerIsGameTypePredicate",
			"condition": {
				"predicate": "player_is_game_type",
				"player": "${attacking_entity}",
				"game_type": [
					"survival",
					"adventure"
				]
			}
		},
		{
			"name": "EntityHasTameOwnerPredicate",
			"condition": {
				"predicate": "entity_has_tame_owner",
				"entity": "${this_entity}",
				"condition": {
					"predicate": "entity_is_type",
					"entity": "${owner_entity}",
					"entity_type": "minecraft:player"
				}
			}
		},
		{
			"name": "EntityProjectileHasOwnerPredicate",
			"condition": {
				"predicate": "entity_projectile_has_owner",
				"entity": "${silicate_test:projectile}",
				"condition": {
					"predicate": "entity_is_type",
					"entity": "${owner_entity}",
					"entity_type": "minecraft:skeleton"
				}
			}
		},
		{
			"name": "EntityHasPassengerPredicate",
			"condition": {
				"predicate": "entity_has_passenger",
				"entity": "${this_entity}",
				"condition": {
					"predicate": "entity_is_type",
					"entity": "${passenger_entity}",
					"entity_type": "minecraft:skeleton"
				}
			}
		},
		{
			"name": "EntityHasVehiclePredicate",
			"condition": {
				"predicate": "entity_has_vehicle",
				"entity": "${victim_entity}",
				"condition": {
					"predicate": "entity_is_type",
					"entity": "${vehicle_entity}",
					"entity_type": "minecraft:skeleton_horse"
				}
			}
		},
		{
			"name": "NotPredicate",
			"condition": {
				"predicate": "not",
				"condition": {
					"predicate": "entity_is_type",
					"entity": "${victim_entity}",
					"entity_type": "minecraft:skeleton_horse"
				}
			}
		},
		{
			"name": "AlwaysPredicate(true)",
			"condition": {
				"predicate": "always",
				"value": true
			}
		},
		{
			"name": "AlwaysPredicate(false)",
			"condition": {
				"predicate": "always",
				"value": false
			},
			"should_succeed": false
		},
		{
			"name": "true",
			"condition": true
		},
		{
			"name": "false",
			"condition": false,
			"should_succeed": false
		},
		{
			"name": "AllPredicate",
			"condition": {
				"predicate": "all",
				"conditions": [
					true,
					{
						"predicate": "entity_is_type",
						"entity": "${this_entity}",
						"entity_type": "minecraft:skeleton_horse"
					},
					{
						"predicate": "entity_is_type",
						"entity": "${this_entity}",
						"entity_type": "#minecraft:skeletons"
					}
				]
			}
		},
		{
			"name": "AnyPredicate",
			"condition": {
				"predicate": "any",
				"conditions": [
					false,
					{
						"predicate": "entity_is_type",
						"entity": "${this_entity}",
						"entity_type": "minecraft:skeleton_horse"
					}
				]
			}
		},
		{
			"name": "Definitions",
			"condition": {
				"definitions": {
					"silicate_test:block_state": {
						"type": "block_state",
						"value": {
							"Name": "minecraft:note_block",
							"Properties": {
								"note": "2",
								"instrument": "banjo"
							}
						}
					}
				},
				"predicate": "equals",
				"value_type": "block_state",
				"left": "${block_state}",
				"right": "${silicate_test:block_state}"
			}
		},
		{
			"name": "EqualsPredicate",
			"condition": {
				"definitions": {
					"silicate_test:stack_size": {
						"type": "integer",
						"value": 64
					}
				},
				"predicate": "equals",
				"value_type": "integer",
				"left": "${silicate_test:stack_size}",
				"right": 64
			}
		},
		{
			"name": "Definition Scopes",
			"condition": {
				"predicate": "all",
				"conditions": [
					{
						"definitions": {
							"silicate_test:life": {
								"type": "integer",
								"value": 42
							}
						},
						"predicate": "always",
						"value": true
					},
					{
						"predicate": "equals",
						"value_type": "integer",
						"left": "${silicate_test:life}",
						"right": 42
					}
				]
			},
			"should_throw": true
		},
		{
			"name": "IsTypePredicate",
			"condition": {
				"predicate": "is_type",
				"parameter": "victim_entity",
				"value_type": "hostile_mob"
			}
		},
		{
			"name": "Templating DynamicValue in Definitions",
			"condition": {
				"definitions": {
					"silicate_test:skelly": {
						"type": "entity",
						"value": "${victim_entity}"
					}
				},
				"predicate": "is_type",
				"parameter": "silicate_test:skelly",
				"value_type": "hostile_mob"
			}
		}
	]
}
